{
  "name": "bb-plugin-chief-of-staff",
  "version": "0.4.2",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Chief of Staff",
    "description": "Watches agents, turns GitHub issues into agent PRs, and delivers them through your configured workflow.",
    "branding": {
      "icon": "./assets/chef-hat.svg",
      "experimental_icons": {
        "chef-hat": "./assets/chef-hat.svg",
        "user-check": "./assets/user-check.svg",
        "user-x": "./assets/user-x.svg",
        "hourglass": "./assets/hourglass.svg",
        "octagon-alert": "./assets/octagon-alert.svg",
        "coins": "./assets/coins.svg",
        "activity": "./assets/activity.svg",
        "trending-up": "./assets/trending-up.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "./skills/chief-of-staff"
    ]
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@radix-ui/react-slot": "^1.2.4",
    "@xyflow/react": "^12.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "hono": "^4.13.17",
    "jsdom": "^31.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "description": "Engineering chief of staff for BB: watches agents, turns GitHub issues into agent work, delivers PRs.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "bb plugin build",
    "build:ci": "npx --yes --package bb-app@0.49.0 bb plugin build",
    "check": "npm run lint && npm run typecheck && npm test"
  }
}
